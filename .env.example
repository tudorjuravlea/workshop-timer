# Which brand this deployment wears. Two forms:
#   a name  ->  brands/<name>.json      e.g. TIMER_BRAND=example
#   a URL   ->  fetched once at startup e.g. TIMER_BRAND=https://acme.com/brand.json
# Unset means the built-in default brand.
# TIMER_BRAND=example

# Set to "off" to refuse ?brand= and the inline colour parameters, so a
# deployment can only ever wear the brand configured above.
# TIMER_BRAND_FROM_URL=off
